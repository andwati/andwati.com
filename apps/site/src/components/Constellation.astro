---
import { buildConstellationGraph } from "../lib/constellation-data";

const graph = await buildConstellationGraph();
---

<div class="constellation" data-constellation>
  <div class="constellation-canvas" data-canvas aria-hidden="true"></div>
  <div class="constellation-tooltip" data-tooltip></div>
  <noscript>
    <p class="meta">
      {graph.nodes.length} entries, connected by shared tags — enable JavaScript to explore the constellation.
    </p>
  </noscript>
</div>

<script type="application/json" id="constellation-data" is:inline set:html={JSON.stringify(graph)} />

<style>
  .constellation {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 60vh;
    margin-bottom: var(--space-6);
  }
  .constellation-canvas {
    width: 100%;
    height: 100%;
  }
  .constellation-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .constellation-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    opacity: 0;
    transition: opacity 0.15s var(--ease-out);
    white-space: nowrap;
  }
</style>

<script>
  import type { ConstellationGraph } from "../lib/constellation-data";
  import { supportsWebGL } from "../lib/webgl-support";

  // A plain top-level mount only ever runs once per module URL, so
  // navigating away from "/" and back via a view transition would leave the
  // canvas blank. astro:page-load fires on first load and every subsequent
  // client-side navigation to "/", and the stored dispose() tears down the
  // previous mount's WebGL context/listeners/rAF loop first.
  let dispose: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    dispose?.();
    dispose = undefined;

    const root = document.querySelector<HTMLElement>("[data-constellation]");
    const canvas = root?.querySelector<HTMLElement>("[data-canvas]");
    const tooltip = root?.querySelector<HTMLElement>("[data-tooltip]");
    const dataEl = document.getElementById("constellation-data");
    if (!root) return;

    if (!(canvas && tooltip && dataEl?.textContent && supportsWebGL())) {
      root.style.display = "none";
      return;
    }
    const graph: ConstellationGraph = JSON.parse(dataEl.textContent);
    if (graph.nodes.length === 0) {
      root.style.display = "none";
      return;
    }

    // three.js (~130KB gzip) is dynamically imported here instead of at the
    // top of this module, and only once the browser is idle — this is
    // decorative, so it must never compete with first paint / LCP for main-
    // thread time. Falls back to a short timeout on browsers without
    // requestIdleCallback (Safari).
    const schedule =
      window.requestIdleCallback ?? ((cb: () => void) => window.setTimeout(cb, 200));
    schedule(async () => {
      const { mountConstellation } = await import("../lib/constellation-scene");
      dispose = mountConstellation(canvas, tooltip, graph);
      root.style.display = "";
    });
  });
</script>
