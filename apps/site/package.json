{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:llms": "node ../../scripts/generate-llms.astro-site.mjs",
    "generate:og": "node ../../scripts/generate-og-images.astro-site.mjs",
    "build": "pnpm run generate:llms && pnpm run generate:og && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lighthouse": "pnpm run build && lhci autorun && lhci autorun --config=lighthouserc.desktop.cjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.2.9",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "marked": "^18.0.11",
    "marked-katex-extension": "^5.1.12",
    "pagefind": "^1.5.2",
    "smol-toml": "^1.8.0",
    "three": "^0.185.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.3"
  }
}
